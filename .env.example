# Copy to .env.local and fill in. Every server variable is validated at
# startup by config/env.ts; the server will not start with an invalid value.
# Each environment (local, preview, staging, production) has its own values.

# --- Public (inlined into the browser bundle; never put secrets here) ---
NEXT_PUBLIC_APP_NAME="BeyondAi Admin"
NEXT_PUBLIC_APP_URL=http://localhost:3001

# --- Database (Postgres: Supabase, Neon, or local) ---
# Pooled connection used by the app.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/beyondai_admin
# Direct (unpooled) connection used by migrations. Same as DATABASE_URL locally.
DIRECT_URL=postgresql://USER:PASSWORD@localhost:5432/beyondai_admin

# --- Auth.js ---
# At least 32 characters; generate one per environment with `npx auth secret`.
AUTH_SECRET=
# Public base URL of this app. Required in production.
AUTH_URL=http://localhost:3001
# SMTP server for sign-in links, for example smtp://user:pass@smtp.example.com:587
# Required in production. Leave unset locally: links are printed to the terminal.
# EMAIL_SERVER=
EMAIL_FROM="BeyondAi Admin <no-reply@beyondai.ph>"

# --- Public enquiry endpoint ---
# Origins allowed to POST /api/leads (comma-separated, no trailing slash).
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Turnstile secret. This Cloudflare test key always passes; production uses a real one.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Version of the privacy notice the public form shows. Must match the public site.
CONSENT_NOTICE_VERSION=2026-10

# --- Optional ---
# Rate limits shared across instances. Without these, limits are per instance.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Enables the daily retention job (Vercel Cron sends it as a bearer token).
# CRON_SECRET=

# --- Seed script only (npm run db:seed) ---
# Comma-separated emails added as active admins. Outside production the seed
# also adds staff@example.com and sample enquiries.
ADMIN_SEED_EMAILS=you@beyondai.ph
